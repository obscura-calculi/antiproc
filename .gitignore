# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE and editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vs/

